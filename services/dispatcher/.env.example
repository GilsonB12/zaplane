# ---- Dispatcher (Go) .env ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaplane

# Meta Cloud API
WHATSAPP_GRAPH_API_VERSION=v21.0
# Fallback de dev (single-tenant). Em produção, o token vem cifrado por canal no banco.
# Token de System User da Zaplane. OBRIGATÓRIO no modelo de conexão assistida:
# os canais assistidos gravam um sentinela em access_token_enc (para não
# replicar o token mestre por tenant) e dependem deste fallback. Vazio =
# toda mensagem desses canais falha com "no_token".
WHATSAPP_ACCESS_TOKEN=

# Tuning do worker
WORKER_CONCURRENCY=4
BATCH_SIZE=50
POLL_INTERVAL_MS=750
DEFAULT_RATE_PER_SEC=20

# ---- Resiliência da fila (migração 012) ----
# De quanto em quanto tempo procurar mensagens presas em 'sending'.
REAPER_INTERVAL_SEC=60
# Tempo em 'sending' a partir do qual a mensagem é dada como órfã e devolvida
# à fila. Precisa ser MAIOR que o pior envio legítimo (espera do rate limiter
# do lote inteiro + timeout HTTP de 20s), com folga — senão o reaper devolve
# mensagem que está sendo enviada agora e o cliente recebe duplicada.
STUCK_AFTER_SEC=300
# Quanto o canal fica fora da fila quando a Meta acusa limite de vazão/cota
# (131048, 130429, 4, 80007...). Curto: o limite costuma liberar sozinho.
PAUSE_RATE_LIMIT_SEC=900
# Idem para credencial/conta inválida (190, 200, 131031...). Mais longo, porque
# só volta a funcionar com ação do operador (trocar o token, por exemplo).
PAUSE_AUTH_SEC=1800
# Validade do cache de canal em memória. Sem TTL, um token corrigido no banco
# nunca chegava ao worker e a fila do cliente não se recuperava sozinha.
CHANNEL_CACHE_TTL_SEC=60
# Janela para gravar o desfecho e devolver à fila o lote ainda não enviado
# quando chega SIGTERM. Precisa ser MAIOR que o tempo limite do envio (25s):
# durante o desligamento ainda pode haver um POST em voo cujo resultado precisa
# ser gravado — se não for, a mensagem volta para a fila e o destinatário
# recebe duas vezes.
SHUTDOWN_GRACE_SEC=30
