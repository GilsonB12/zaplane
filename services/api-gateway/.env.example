# ---- API Gateway (.env) ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Banco (Postgres local, sem Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaplane?schema=public

# JWT
JWT_ACCESS_SECRET=troque-isto-em-producao-access
JWT_REFRESH_SECRET=troque-isto-em-producao-refresh
JWT_ACCESS_TTL=900            # 15 min (segundos)
JWT_REFRESH_TTL=2592000       # 30 dias (segundos)

# Serviço importador (Python/FastAPI)
IMPORTER_URL=http://localhost:8000

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-de-verificacao
WHATSAPP_APP_SECRET=app-secret-da-meta-para-assinatura-do-webhook

# Chave para cifrar PII/segredos no nivel da aplicacao (TODO: mover p/ KMS)
APP_ENCRYPTION_KEY=chave-base64-de-32-bytes-troque-isto
