# ---- API Gateway (.env) ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Banco (Postgres local, sem Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zaplane?schema=public

# JWT
JWT_ACCESS_SECRET=troque-isto-em-producao-access
JWT_REFRESH_SECRET=troque-isto-em-producao-refresh
JWT_ACCESS_TTL=900            # 15 min (segundos)
JWT_REFRESH_TTL=2592000       # 30 dias (segundos)

# Rate limit: requisições por minuto POR USUÁRIO autenticado (anônimo cai no
# IP real — exige o proxy confiável, ver `trust proxy` no main.ts). Os webhooks
# da Meta e do Asaas são isentos via @SkipThrottle; as rotas de login/registro
# têm limite próprio e bem menor, definido no auth.controller.ts.
RATE_LIMIT_PER_MIN=300

# Serviço importador (Python/FastAPI)
IMPORTER_URL=http://localhost:8000

# Meta WhatsApp Cloud API
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-de-verificacao
# IMPORTANTE: WHATSAPP_APP_SECRET DEVE ser o App Secret do MESMO app Zaplane usado
# no Embedded Signup (ZAPLANE_FB_APP_ID/ZAPLANE_FB_APP_SECRET abaixo) — os webhooks
# dos canais conectados via ES são validados com ele (secret global, fase 1).
WHATSAPP_APP_SECRET=app-secret-da-meta-para-assinatura-do-webhook
# Token de acesso do System User da Zaplane (Meta Business Manager). NAO e o
# token por canal do cliente (esse fica cifrado no banco, por canal). Este e
# usado SO pela CONEXAO ASSISTIDA para adicionar, verificar o codigo e
# registrar o numero do cliente na WABA da propria Zaplane — sem ele, toda
# chamada a Graph API nesse fluxo falha por autenticacao. NUNCA commitar o
# valor real.
WHATSAPP_ACCESS_TOKEN=

# Chave para cifrar PII/segredos no nivel da aplicacao (TODO: mover p/ KMS)
APP_ENCRYPTION_KEY=chave-base64-de-32-bytes-troque-isto

# Cobranca (billing): taxa Zaplane por mensagem efetivamente tarifada pela Meta
# (webhook status.pricing.billable=true), debitada da carteira pre-paga da org.
BILLING_USAGE_PRICE_CENTS=43
# Preco da assinatura mensal (centavos). R$135,00 = 13500.
BILLING_SUBSCRIPTION_PRICE_CENTS=13500

# ---- Cobranca / Billing — provedor de pagamento (Asaas) ----
# Provedor ativo por tras da interface PaymentProviderAdapter (billing/providers/).
PAYMENT_PROVIDER=asaas
# Sandbox (homologacao, dinheiro fake). Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Chave de API do Asaas (painel Asaas > Integracoes > API). NUNCA commitar a chave real.
ASAAS_API_KEY=
# Token que VOCE inventa e cadastra no painel Asaas (Integracoes > Webhooks) para
# autenticar o header `asaas-access-token` recebido em POST /webhooks/billing/asaas.
# IMPORTANTE (Fix C1, review B3): o valor abaixo e um PLACEHOLDER PUBLICO (fica
# neste arquivo, versionado). O app RECUSA iniciar em producao (NODE_ENV=production)
# se ASAAS_WEBHOOK_TOKEN estiver vazio ou IGUAL a este exato valor — troque por um
# token forte e unico antes de configurar o webhook real no painel Asaas.
ASAAS_WEBHOOK_TOKEN=TROQUE-ESTE-VALOR-ISTO-NAO-E-UM-SEGREDO

# URL pública do gateway (ex.: https://api.seuapp.com) usada para o handshake do
# webhook na Meta ao conectar um canal manual — precisa ser alcançável pela Meta
# (em dev local, use um túnel tipo ngrok/cloudflared apontando p/ :3000).
WEBHOOK_PUBLIC_URL=

# App do Facebook/Meta do próprio Zaplane, usado no fluxo de Embedded Signup
# (popup de conexão do WhatsApp direto no painel, sem o cliente digitar token).
ZAPLANE_FB_APP_ID=
ZAPLANE_FB_APP_SECRET=
# Configuration ID do Embedded Signup (criado no painel de apps da Meta, em
# WhatsApp > Configuração incorporada).
ZAPLANE_ES_CONFIG_ID=

# ---- Conexão assistida ----
# WABA da Zaplane que recebe os números dos clientes
ZAPLANE_WABA_ID=1972668750117567
# Teto de números por WABA na Meta
ZAPLANE_WABA_PHONE_CAP=20
# Canais ativos por organização
ORG_MAX_CHANNELS=1
# Destinatários únicos por organização em 24h. O limite da Meta é do PORTFÓLIO
# e compartilhado — sem esta cota um cliente consome a capacidade de todos.
ORG_DAILY_MESSAGE_QUOTA=200
# Tentativas de conexão assistida por organização em 24h (qualquer status).
# Protege o teto GLOBAL de vagas da WABA da Zaplane (ZAPLANE_WABA_PHONE_CAP):
# sem esta cota, uma única organização insistindo esgota as vagas de todos.
ORG_MAX_CONNECT_ATTEMPTS_24H=5
# Vagas QUEIMADAS por organização em 24h: solicitações em que a Meta já aceitou
# o número (vaga consumida, e ela não volta por API) sem terminar conectadas.
# Trava diferente da de cima, que conta tentativas — tentativa recusada pela
# Meta não custa vaga. Com ~20 vagas para a plataforma inteira e 1 canal por
# organização, 2 dá margem para um percalço real e limita o estrago diário de
# uma organização a 10% da capacidade de todos.
ORG_MAX_BURNED_SLOTS_24H=2
# Timeout (ms) de cada chamada à Graph API no fluxo de conexão assistida.
# Sem timeout, uma conexão pendurada trava a requisição do cliente e deixa a
# solicitação parada com a vaga já consumida.
META_HTTP_TIMEOUT_MS=15000
