# Base da API. Em dev, deixe vazio para usar o proxy do Vite (/api/v1 → :3000).
VITE_API_URL=/api/v1

# App do Facebook/Meta do Zaplane usado no popup de Embedded Signup (conectar
# WhatsApp direto do painel). Deve ser o MESMO app do ZAPLANE_FB_APP_ID no gateway.
VITE_FB_APP_ID=
# Configuration ID do Embedded Signup (mesmo valor do ZAPLANE_ES_CONFIG_ID no gateway).
VITE_ES_CONFIG_ID=
