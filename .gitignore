.DS_Store
Thumbs.db
.idea/
.vscode/
# Segredos / uploads
*.pem
uploads_tmp/

# FUSE leftovers
.fuse_hidden*

# Superpowers SDD scratch (ledger / diffs) — não versionar
.superpowers/

# Documentos pessoais/empresariais — nunca versionar (contem PII)
CCMEI*.pdf
*.pdf
